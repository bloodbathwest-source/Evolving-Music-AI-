import { useMutation } from '@tanstack/react-query';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { useState } from 'react';
// Replace with actual Base44 SDK import
const base44 = { post: async (url, data) => ({ data: { lyrics: 'Generated lyrics' } }) };

function Create() {
  const [title, setTitle] = useState('');
  const mutation = useMutation({
    mutationFn: async (data) => {
      const response = await base44.post('/generate-lyrics', { title: data.title });
      return response.data.lyrics;
    },
  });

  const handleGenerateLyrics = () => {
    mutation.mutate({ title });
  };

  return (
    <div>
      <h2 className="text-3xl font-bold">Create Song</h2>
      <Input
        value={title}
        onChange={(e) => setTitle(e.target.value)}
        placeholder="Song Title"
        className="mb-4"
        aria-label="Song title"
      />
      <Button onClick={handleGenerateLyrics} disabled={mutation.isLoading}>
        {mutation.isLoading ? 'Generating...' : 'Generate Lyrics'}
      </Button>
      {mutation.data && <pre>{mutation.data}</pre>}
    </div>
  );
}

export default Create;
