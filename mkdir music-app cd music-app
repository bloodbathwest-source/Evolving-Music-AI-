import { useQuery } from '@tanstack/react-query';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { motion } from 'framer-motion';
// Replace with actual Base44 SDK import
const base44 = { get: async () => ({ data: [{ name: 'Sample 1', sample_type: 'Drum Loop', duration: 10, file_url: 'https://example.com/sample1.mp3', tags: ['loop', 'electronic'] }]) });

function Samples() {
  const { data: samples, isLoading, error } = useQuery({
    queryKey: ['samples'],
    queryFn: async () => {
      const response = await base44.get('/samples');
      return response.data;
    },
  });

  if (isLoading) return <div>Loading...</div>;
  if (error) return <div>Error: {error.message}</div>;

  return (
    <motion.div
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      transition={{ duration: 0.5 }}
      className="space-y-4"
    >
      <h2 className="text-3xl font-bold">Audio Sample Warehouse</h2>
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {samples?.map((sample) => (
          <Card key={sample.name}>
            <CardHeader>
              <CardTitle>{sample.name}</CardTitle>
            </CardHeader>
            <CardContent>
              <p>Type: {sample.sample_type}</p>
              <p>Duration: {sample.duration}s</p>
              {sample.bpm && <p>BPM: {sample.bpm}</p>}
              {sample.key && <p>Key: {sample.key}</p>}
              <p>Tags: {sample.tags?.join(', ')}</p>
              <audio controls src={sample.file_url} className="mt-2 w-full" aria-label={`Play ${sample.name}`} />
              <Button asChild>
                <a href={sample.file_url} download aria-label={`Download ${sample.name}`}>Download</a>
              </Button>
            </CardContent>
          </Card>
        ))}
      </div>
    </motion.div>
  );
}

export default Samples;
